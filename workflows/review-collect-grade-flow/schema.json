{
  "workflow_id": "de_local_02_wf01",
  "name": "评价采集与分级",
  "type": "composite",
  "skill_refs": ["de_local_02_sk01", "de_local_02_sk02", "de_local_02_sk03", "de_local_02_sk04"],
  "input": {
    "type": "object",
    "required": ["reviews"],
    "properties": {
      "shop": {"type": "string", "description": "门店名"},
      "collect_at": {"type": "string", "description": "采集批次时间，如 2026-09-30 09:00"},
      "channel": {"type": "string", "enum": ["A", "B"], "description": "采集通道：A=开放接口 / B=人工导出（T+1 新鲜度）"},
      "reviews": {
        "type": "array",
        "description": "评价数组；stars/text 缺失即失败退出，不补默认值",
        "items": {
          "type": "object",
          "required": ["id", "platform", "stars", "text"],
          "properties": {
            "id": {"type": "string", "description": "评价ID，幂等去重键"},
            "platform": {"type": "string", "enum": ["美团", "点评", "抖音"]},
            "stars": {"type": "integer", "minimum": 1, "maximum": 5},
            "text": {"type": "string", "description": "评价正文；纯星级评价传空串并标注简版"},
            "review_time": {"type": "string", "description": "发布时间；缺失排本桶末位并标注"},
            "reply_status": {"type": "string", "enum": ["已回复", "未回复"]},
            "order_id": {"type": "string", "description": "订单号，申诉与补偿核对凭据"}
          }
        }
      }
    }
  },
  "output": {
    "type": "object",
    "required": ["summary", "items"],
    "properties": {
      "summary": {
        "type": "object",
        "description": "三桶计数 / 未回复差评 / 转人工条数 / 好评占比对照健康线",
        "properties": {
          "评价总量": {"type": "integer"},
          "差评": {"type": "integer"},
          "中评": {"type": "integer"},
          "好评": {"type": "integer"},
          "未回复差评": {"type": "integer"},
          "转人工条数": {"type": "integer"}
        }
      },
      "items": {
        "type": "array",
        "description": "分级处理队列，按 SLA 排序",
        "items": {
          "type": "object",
          "properties": {
            "评价ID": {"type": "string"},
            "平台": {"type": "string"},
            "星级": {"type": "integer"},
            "桶位": {"type": "string", "enum": ["差评", "中评", "好评"]},
            "强负面词": {"type": "string"},
            "响应窗口": {"type": "string", "description": "差评 2 小时内 / 中评 24 小时内 / 好评 48 小时内"},
            "处置": {"type": "string"}
          }
        }
      }
    },
    "x-rendered-from": "capability:collect_grade_flow"
  },
  "scripts": {
    "run_flow": "scripts/run_flow.py",
    "usage": "python3 scripts/run_flow.py --input input.json --outdir out"
  },
  "artifacts": ["out/分级处理队列.xlsx", "out/评价星级分布.png", "out/collect_grade.json"],
  "constraints": {
    "sla_hours": {"差评": 2, "中评": 24, "好评": 48},
    "conflict_rule": "星级与词表冲突取更负一档",
    "food_safety_rule": "食安/人身攻击词命中即按差评最高优先级并转人工，无论星级",
    "reply_rate_target": "100%",
    "positive_rate_benchmark": "本地生活门店好评率健康线 ≥ 85%",
    "ai_label_required": true,
    "human_review_required": true
  }
}
